		compatible = "DSP2MIPS_INT";
		interrupts = <0x0 0x5f 0x4>;
	};

	vdmcu2hk_int {
		compatible = "vdmcu2hk_int";
		interrupts = <0x0 0x57 0x4>;
	};

	cec_int_pm {
		compatible = "cec_int_pm";
		interrupts = <0x0 0x11 0x4>;
	};

	sc_hk_int {
		compatible = "sc_hk_int";
		interrupts = <0x0 0xaf 0x4>;
	};

	ext_gpio_int0 {
		compatible = "ext_gpio_int0";
		interrupts = <0x0 0x67 0x4>;
	};

	d2b_int {
		compatible = "d2b_int";
		interrupts = <0x0 0x17 0x4>;
	};

	firmware {

		android {
			mode = "123456789";
			Processor = "AArch64 Processor rev 3 (aarch64)";
			bootloader = "123456789";
			compatible = "android,firmware";
			hardware = "m7642";
			Serial = "0000000000000000";
			baseband = "123456789";
			revision = "1234";

			fstab {
				compatible = "android,fstab";

				vendor {
					dev = "/dev/block/platform/mstar_mci.0/by-name/vendor";
					compatible = "android,vendor";
					mnt_flags = "ro";
					fsmgr_flags = "wait";
					type = "ext4";
				};

				tvconfig {
					dev = "/dev/block/platform/mstar_mci.0/by-name/tvconfig";
					compatible = "android,tvconfig";
					mnt_flags = "ro";
					fsmgr_flags = "wait";
					type = "ext4";
				};
			};
		};
	};

	switch_gpio {
		switch-name = "h2w";
		compatible = "mstar,switch-gpio";
		switch-gpio = <0x3e7>;
		switch-inverse = <0x0>;
	};

	int_uart2 {
		compatible = "int_uart2";
		interrupts = <0x0 0xa9 0x4>;
	};

	Mstar-utopia2k-str {
		compatible = "Mstar-utopia2k-str";

		ace {

			suspend {

				stage0 {
					post-condition = "ace";
				};
			};

			resume {

				stage0 {
					pre-condition = "xc";
					post-condition = "ace";
				};
			};
		};

		vif {

			resume {

				stage0 {
					post-condition = "vif";
				};
			};
		};

		mhl {

			resume {

				stage0 {
					pre-condition = "hdmi_rx";
				};
			};
		};

		xc {

			suspend {

				stage0 {
					pre-condition = "pq", "ace";
					post-condition = "xc";
				};
			};

			resume {

				stage0 {
					pre-condition = "vdec", "avd", "miu", "mvop", "pnl";
					post-condition = "xc";
				};
			};
		};

		miu {

			resume {

				stage0 {
					post-condition = "miu";
				};
			};
		};

		hdmi_rx {

			resume {

				stage0 {
					post-condition = "hdmi_rx";
				};
			};
		};

		avd {

			resume {

				stage0 {
					pre-condition = "vif";
					post-condition = "avd";
				};
			};
		};

		mvop {

			resume {

				stage0 {
					post-condition = "mvop";
				};
			};
		};

		pq {

			suspend {

				stage0 {
					post-condition = "pq";
				};
			};

			resume {

				stage0 {
					pre-condition = "xc";
					post-condition = "pq";
				};
			};
		};

		ve {

			resume {

				stage0 {
					pre-condition = "miu", "xc";
				};
			};
		};

		vdec {

			resume {

				stage0 {
					post-condition = "vdec";
				};
			};
		};

		pnl {

			suspend {

				stage0 {
					pre-condition = "xc";
				};
			};

			resume {

				stage0 {
					post-condition = "pnl";
				};
			};
		};
	};

	hdcp_x74_int {
		compatible = "hdcp_x74_int";
		interrupts = <0x0 0x38 0x4>;
	};

	Mstar-ehci-1 {
		compatible = "Mstar-ehci-1";
	};

	imi_top_irq {
		compatible = "imi_top_irq";
		interrupts = <0x0 0x56 0x4>;
	};

	gpio_wifi_ctl {
		compatible = "mstar,gpio-wifi-ctl";
		wifi-ctl-gpio = <0x11>;
	};

	SPDIF_IN_NON_PCM_INT_OUT {
		compatible = "SPDIF_IN_NON_PCM_INT_OUT";
		interrupts = <0x0 0x4c 0x4>;
	};

	int_timer2 {
		compatible = "int_timer2";
		interrupts = <0x0 0x6d 0x4>;
	};

	smart_int {
		compatible = "smart_int";
		interrupts = <0x0 0x37 0x4>;
	};

	mstar-pm {
		compatible = "mstar-pm";
	};

	dip2_sec_int {
		compatible = "dip2_sec_int";
		interrupts = <0x0 0xc2 0x4>;
	};

	PM_SD_CDZ1_int {
		compatible = "PM_SD_CDZ1_int";
		interrupts = <0x0 0x63 0x4>;
	};

	Mstar-ehci-4 {
		compatible = "Mstar-ehci-4";
	};

	ve_int {
		compatible = "ve_int";
		interrupts = <0x0 0x3a 0x4>;
	};

	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;

		cpu@0 {
			phandle = <0x2>;
			reg = <0x0 0x0>;
			compatible = "arm,cortex-a73", "arm,armv8";
			cpu-release-addr = <0x0 0x100510>;
			enable-method = "mstar-spin-table";
			linux,phandle = <0x2>;
			device_type = "cpu";
		};

		cpu-map {

			cluster0 {
				phandle = <0x8>;
				#cooling-cells = <0x2>;
				linux,phandle = <0x8>;

				core0 {
					cpu = <0x2>;
				};

				core1 {
					cpu = <0x3>;
				};

				core3 {
					cpu = <0x5>;
				};

				core2 {
					cpu = <0x4>;
				};
			};
		};

		cpu@2 {
			phandle = <0x4>;
			reg = <0x0 0x2>;
			compatible = "arm,cortex-a73", "arm,armv8";
			cpu-release-addr = <0x0 0x100510>;
			enable-method = "mstar-spin-table";
			linux,phandle = <0x4>;
			device_type = "cpu";
		};

		cpu@1 {
			phandle = <0x3>;
			reg = <0x0 0x1>;
			compatible = "arm,cortex-a73", "arm,armv8";
			cpu-release-addr = <0x0 0x100510>;
			enable-method = "mstar-spin-table";
			linux,phandle = <0x3>;
			device_type = "cpu";
		};

		cpu@3 {
			phandle = <0x5>;
			reg = <0x0 0x3>;
			compatible = "arm,cortex-a73", "arm,armv8";
			cpu-release-addr = <0x0 0x100510>;
			enable-method = "mstar-spin-table";
			linux,phandle = <0x5>;
			device_type = "cpu";
		};
	};

	xc {
		compatible = "mstar-xc";
