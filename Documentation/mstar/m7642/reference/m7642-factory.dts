	};

	mmc_host_sdio {
		pc-option = <0x0 0x0 0x0 0x0>;
		sdio-fast-connect = <0x0>;
		compatible = "mstar, sdio";
		sdio-padmux = <0x1>;
		wp-option = <0x0 0x0 0x0 0x0>;
		sdio-volt-type = <0x0>;
		cd-option = <0x1 0xf 0x1a 0x2>;
	};

	backlight {
		vcc_gpio = <0x2c>;
		default-brightness-level = <0xff>;
