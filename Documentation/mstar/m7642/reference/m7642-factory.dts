	thermal-zones {

		mtk-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x6 0x0>;

			cooling-maps {

				map0 {
					cooling-device = <0x8 0xffffffff 0xffffffff>;
					trip = <0x7>;
					contribution = <0x400>;
				};
			};

			trips {

				trip-point@1 {
					phandle = <0x7>;
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					linux,phandle = <0x7>;
					type = "passive";
				};

				trip-point@0 {
					temperature = <0x1c138>;
					hysteresis = <0x3e8>;
					type = "passive";
				};
			};
		};
	};

	scm_int {
		compatible = "scm_int";
		interrupts = <0x0 0x1b 0x4>;
	};

	xiu_timeout_int {
		compatible = "xiu_timeout_int";
		interrupts = <0x0 0x53 0x4>;
	};

	pm_sleep_int {
