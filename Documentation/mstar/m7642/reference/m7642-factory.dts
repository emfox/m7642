	};

	reg_hst3to0_int {
		compatible = "reg_hst3to0_int";
		interrupts = <0x0 0x72 0x4>;
	};

	soc-dvfs {
		cluster = <0x1>;
		package = <0x1>;
		enable = <0x1>;

		cluster_0 {

			cpu-info {
				freqaddr = <0x1f200a04>;
				mcubank = <0x101d00>;
				mask = <0x0>;
				anabank = <0x110c00>;
				partid = <0xd03>;
			};

			table-info_0 {

				sys-info {
					default-clock = <0x3e8>;
					default-cpu = <0x64>;
					max-cpu = <0x78>;
					min-clock = <0x3e8>;
					antutu-clock = <0x55a>;
					protect-clock = <0x320>;
					max-clock = <0x55a>;
					default-core = <0x64>;
					min-cpu = <0x5a>;
					boost-clock = <0x514>;
				};

				temp-info {
					normal_upper = <0x87>;
					normal_lower = <0x78>;
					freeze_lower = <0xff>;
					freeze_upper = <0xff>;
					power-ss = <0x5a>;
					reset = <0x96>;
					power-ff = <0x5a>;
				};

				clock-info {
					level = <0x4>;

					pairs {

						setting_3 {
							min-clock = <0x55a>;
							power-ss = <0x78>;
							max-clock = <0x55b>;
							power-ff = <0x73>;
						};

						setting_1 {
							min-clock = <0x4b0>;
							power-ss = <0x6e>;
							max-clock = <0x514>;
							power-ff = <0x69>;
						};

						setting_2 {
							min-clock = <0x514>;
							power-ss = <0x73>;
							max-clock = <0x55a>;
							power-ff = <0x6e>;
						};

						setting_0 {
							min-clock = <0x3e8>;
							power-ss = <0x64>;
							max-clock = <0x4b0>;
							power-ff = <0x5f>;
						};
					};
				};

				core-info {
					min-clock = <0x258>;
					power-ss = <0x64>;
					max-clock = <0x258>;
					power-ff = <0x5f>;
				};

				power-info {
					type = "i2c";

					parm {
						shift = <0x1>;
						slave-id = <0x80>;
						id = <0x9a>;
						set = "hw";
						step = <0x3>;
						port = <0x3>;
					};
				};
			};
		};
	};

	ci_gpio_int {
		compatible = "ci_gpio_int";
		interrupts = <0x0 0xb1 0x4>;
