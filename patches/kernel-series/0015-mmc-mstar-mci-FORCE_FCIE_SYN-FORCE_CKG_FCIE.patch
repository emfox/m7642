- FORCE_FCIE_SYN：日志显示 syn 本来就是 0x1，不是问题（§34.48 实验1）
- FORCE_CKG_FCIE：LEGACY timing 下驱动按设计用 FCIE_SLOW_CLK，PLL 分支不执行，
  所以 reg_ckg_fcie=0x6400 是正常的慢时钟配置，也不是问题（§34.48 实验2）
- 下一步：在 request 里对 opcode==6 dump 现场（只加日志）
---
 drivers/mmc/host/Kconfig                   | 42 ++++++++++++++++++++++
 drivers/mmc/host/mstar-mci/eMMC_platform.c | 18 ++++++++++
 2 files changed, 60 insertions(+)

diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index 4bff6f7f4..7b3f66eb7 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -1198,3 +1198,45 @@ config M7642_FORCE_LOWSPEED
 	  enough to read partitions while the high-speed path is investigated.
 
 	  Say Y for the m7642 bring-up.
+
+config M7642_HAL_MIN
+	bool "m7642: do not reprogram the eMMC PLL / PAD registers"
+	depends on MMC_MSTAR_MCI
+	help
+	  The eMMC HAL in this driver comes from the M7322 (MT9653) vendor tree;
+	  its emmcpll_0x* / chiptop_0x* writes are that chip's values.  On the
+	  m7642 the bootloader already leaves the eMMC PLL and pads configured
+	  (the vendor kernel never reprograms them from Linux), and writing the
+	  M7322 values on top puts the controller in a state where CMD6 (the
+	  high-speed switch) never completes.
+
+	  With this option the HAL skips those writes and only keeps the FCIE
+	  side setup, plus it forces reg_ckg_fcie_syn to the value the m7642
+	  vendor kernel has (0x0001).
+
+	  Say Y for the m7642 bring-up.
+
+config M7642_FORCE_FCIE_SYN
+	bool "m7642: force reg_ckg_fcie_syn = 0x0001"
+	depends on MMC_MSTAR_MCI
+	help
+	  The eMMC HAL expects CLKGEN2+0x0C (reg_ckg_fcie_syn) to read 0x0001 and
+	  has a self-check for it, but on the m7642 the value observed after our
+	  init is 0x0003 and the m7642 vendor kernel has 0x0001.  This forces the
+	  vendor value right after the identification-clock setup -- one change,
+	  everything else left alone.  First step of the m7642 eMMC bring-up.
+
+	  Say Y for the m7642 bring-up.
+
+config M7642_FORCE_CKG_FCIE
+	bool "m7642: force reg_ckg_fcie to the vendor value when using the eMMC PLL"
+	depends on MMC_MSTAR_MCI
+	help
+	  On the m7642 the vendor kernel has CLKGEN0+0x64 (reg_ckg_fcie) = 0x00f0,
+	  i.e. BIT6 (clock source = eMMC PLL) plus (0xC << 2) (PLL 2X) plus bit7.
+	  Our HAL (M7322 values) leaves something that does not decode to any
+	  defined bit pattern, and CMD6 (the high-speed switch, which happens right
+	  after the host moves to 25 MHz) never completes.
+
+	  This forces the vendor value in the PLL branch of eMMC_clock_setting().
+	  Second single-point step of the m7642 eMMC bring-up.
diff --git a/drivers/mmc/host/mstar-mci/eMMC_platform.c b/drivers/mmc/host/mstar-mci/eMMC_platform.c
index 4085ecd3a..7e8dc1119 100644
--- a/drivers/mmc/host/mstar-mci/eMMC_platform.c
+++ b/drivers/mmc/host/mstar-mci/eMMC_platform.c
@@ -444,6 +444,13 @@ U32 eMMC_pads_switch(U32 u32Mode)
 	volatile U16 u16_reg;
     g_eMMCDrv.u8_PadType = u32Mode;
 
+#if IS_ENABLED(CONFIG_M7642_HAL_MIN)
+    /*
+     * m7642: these chiptop/emmcpll values are the M7322 vendor tree's; the
+     * bootloader already configured this board.  Only keep the FCIE side.
+     */
+    return eMMC_ST_SUCCESS;
+#endif
     // chiptop
     REG_FCIE_CLRBIT(reg_chiptop_0x6F, BIT_NAND_MODE);
     REG_FCIE_R(reg_chiptop_0x6E, u16_reg);
@@ -999,6 +1006,11 @@ U32 eMMC_clock_setting(U16 u16_ClkParam)
 		REG_FCIE_CLRBIT(reg_ckg_fcie_syn, BIT0|BIT1);
 		REG_FCIE_SETBIT(reg_ckg_fcie_syn, BIT0);
 	}
+#if IS_ENABLED(CONFIG_M7642_FORCE_FCIE_SYN)
+	/* m7642 vendor kernel reads 0x0001 here; our init leaves 0x0003. */
+	REG_FCIE_W(reg_ckg_fcie_syn, 0x0001);
+	pr_info("M7642 force reg_ckg_fcie_syn=0x0001 (was %#x)\n", u16_Tmp);
+#endif
     #if defined(CONFIG_MSTAR_ARM_BD_FPGA) && CONFIG_MSTAR_ARM_BD_FPGA
     if(u16_ClkParam == BIT_FCIE_CLK_300K)
         REG_FCIE_SETBIT(reg_emmcpll_0x1d, BIT0);
@@ -1660,6 +1672,11 @@ U32 eMMC_PlatformInit(void)
     // eMMC_debug(eMMC_DEBUG_LEVEL_LOW, 1, "1.8V IO power for eMMC\n");
     // Irwin Tyan: set this bit to boost IO performance at low power supply.
 
+#if IS_ENABLED(CONFIG_M7642_HAL_MIN)
+    pr_info("M7642 HAL_MIN: eMMC PLL/PAD untouched; ckg_fcie=%#x syn=%#x emmc_test=%#x\n",
+            REG_FCIE_U16(reg_ckg_fcie), REG_FCIE_U16(reg_ckg_fcie_syn),
+            REG_FCIE_U16(reg_emmc_test));
+#else
     if((REG_FCIE(reg_emmc_test) & BIT0) != 1)
     {
         //eMMC_debug(0, 0, "eMMC: set 1.8V \n");
@@ -1668,6 +1685,7 @@ U32 eMMC_PlatformInit(void)
         REG_FCIE_CLRBIT(reg_emmcpll_0x45, 0x0fff);// 1.8V must set this bit
         REG_FCIE_SETBIT(reg_emmcpll_0x45, 0xf);// 1.8V must set this bit
     }
+#endif
     #else
     eMMC_debug(eMMC_DEBUG_LEVEL_LOW, 1, "3.3V IO power for eMMC\n");
     pRegEmmcPll->reg_emmc_test = 0; // 3.3V must clear this bit
