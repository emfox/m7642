结论见 §34.64：
1) 探针接管后 panic() 函数体不执行（线性映射标记验证）
2) 去掉探针则 panic() 执行但 machine_restart 未实现 ⟹ 挂住，日志随断电丢失
⟹ panic 取证必须做在探针 tramp 里（调用一个 noinline 的内核 C 函数）
---
 kernel/panic.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/kernel/panic.c b/kernel/panic.c
index f08453f0d..9ea5b4e4b 100644
--- a/kernel/panic.c
+++ b/kernel/panic.c
@@ -790,6 +790,18 @@ EXPORT_SYMBOL(vpanic);
 /* Identical to vpanic(), except it takes variadic arguments instead of va_list */
 void panic(const char *fmt, ...)
 {
+#if IS_ENABLED(CONFIG_M7642_PANIC_LOG)
+	/*
+	 * M7642 panic body marker: proves panic()'s body actually runs after our
+	 * checkpoint trampoline intercepted its entry.  Uses the linear map (__va),
+	 * so it is safe in panic context (no ioremap, no locks).
+	 */
+	{
+		u32 *m7642_p = (u32 *)__va(0x230a0000UL);
+		m7642_p[0] = 0x4d373634;	/* "M764" */
+		m7642_p[1] = 0xdeadbeef;
+	}
+#endif
 	va_list args;
 
 	va_start(args, fmt);
