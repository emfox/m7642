结论：埋点一条都没打印 ⟹ __mmc_switch 在 CMD6 处就 goto out ⟹ 失败的是 CMD6(SWITCH)
本身，不是后续时序切换。见 Documentation/mstar/m7642/confirmed-facts.md §34.45。
（这两个 pr_info 是 bring-up 用的，最终要删。）
---
 drivers/mmc/core/core.c    | 1 +
 drivers/mmc/core/mmc_ops.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/drivers/mmc/core/core.c b/drivers/mmc/core/core.c
index 29e80e5f9..dea4d6212 100644
--- a/drivers/mmc/core/core.c
+++ b/drivers/mmc/core/core.c
@@ -1278,6 +1278,7 @@ int mmc_set_uhs_voltage(struct mmc_host *host, u32 ocr)
  */
 void mmc_set_timing(struct mmc_host *host, unsigned int timing)
 {
+	pr_info("MMCDBG: set_timing %u -> %u\n", host->ios.timing, timing);
 	host->ios.timing = timing;
 	mmc_set_ios(host);
 }
diff --git a/drivers/mmc/core/mmc_ops.c b/drivers/mmc/core/mmc_ops.c
index a952cc826..4840e386d 100644
--- a/drivers/mmc/core/mmc_ops.c
+++ b/drivers/mmc/core/mmc_ops.c
@@ -651,6 +651,8 @@ int __mmc_switch(struct mmc_card *card, u8 set, u8 index, u8 value,
 
 out_tim:
 	/* Switch to new timing before check switch status. */
+	pr_info("MMCDBG: __mmc_switch index=%u value=%u timing=%u send_status=%d err=%d\n",
+		index, value, timing, send_status, err);
 	if (timing)
 		mmc_set_timing(host, timing);
 
