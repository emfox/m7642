From de688f0dea25c420167cd6c62282006f5c3df9c8 Mon Sep 17 00:00:00 2001
From: emfox <emfox@debian.org>
Date: Tue, 17 Nov 2026 17:12:23 +0800
Subject: [PATCH 03/29] arm64: mstar: add m7642 platform and TCL 65S535D device
 tree

Add the ARCH_MSTAR platform symbol so the device tree and the USB PHY
driver have something to hang off, then describe the board: four Cortex-A73
cores, a GIC-400, the architected timer, the 8250 console and the
framebuffer the bootloader leaves scanning out.

The console is a plain 8250 with an 8-byte register stride, so reg-shift is
3 and accesses are 32 bits wide.  Memory is described as three windows
because the vendor tree only publishes the first 128 MB and leaves the rest
to the bootloader.

The USB controllers and their PHYs are described but disabled: the ports
cannot be brought up until the PHY sequence has been checked on hardware.

Signed-off-by: emfox <emfox@debian.org>
---
 arch/arm64/Kconfig.platforms                  |   9 +
 arch/arm64/boot/dts/Makefile                  |   1 +
 arch/arm64/boot/dts/mstar/Makefile            |   2 +
 .../boot/dts/mstar/m7642-tcl-65s535d.dts      |  80 +++++++
 arch/arm64/boot/dts/mstar/m7642.dtsi          | 200 ++++++++++++++++++
 5 files changed, 292 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mstar/Makefile
 create mode 100644 arch/arm64/boot/dts/mstar/m7642-tcl-65s535d.dts
 create mode 100644 arch/arm64/boot/dts/mstar/m7642.dtsi

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index d2acfac73..715e971eb 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -188,6 +188,15 @@ config ARCH_MEDIATEK
 	  This enables support for MediaTek MT27xx, MT65xx, MT76xx
 	  & MT81xx ARMv8 SoCs
 
+config ARCH_MSTAR
+	bool "MStar TV SoCs"
+	select ARM_GIC
+	select HAVE_ARM_ARCH_TIMER
+	help
+	  This enables support for MStar TV SoCs, now part of MediaTek.
+	  Currently covers the m7642, marketed as the MT9652.
+
+
 config ARCH_MESON
 	bool "Amlogic Platforms"
 	help
diff --git a/arch/arm64/boot/dts/Makefile b/arch/arm64/boot/dts/Makefile
index fc726b215..62de240fd 100644
--- a/arch/arm64/boot/dts/Makefile
+++ b/arch/arm64/boot/dts/Makefile
@@ -25,6 +25,7 @@ subdir-y += lg
 subdir-y += marvell
 subdir-y += mediatek
 subdir-y += microchip
+subdir-y += mstar
 subdir-y += nuvoton
