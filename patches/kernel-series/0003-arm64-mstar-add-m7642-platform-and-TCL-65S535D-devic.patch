diff --git a/arch/arm64/boot/dts/mstar/Makefile b/arch/arm64/boot/dts/mstar/Makefile
new file mode 100644
index 000000000..520f27d30
--- /dev/null
+++ b/arch/arm64/boot/dts/mstar/Makefile
@@ -0,0 +1,2 @@
