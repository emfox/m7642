new file mode 100644
index 0000000..a717fb8
--- /dev/null
+++ b/drivers/phy/mstar/phy-mstar-usb.c
@@ -0,0 +1,310 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * MStar m7642 USB2 UTMI PHY
+ *
+ * One instance per EHCI port.  A port owns three register windows: UTMI
+ * (the analog part), USBC (MAC control) and UHC (host glue).  Registers in
+ * these windows are 16 bits wide and addressed at twice their register
+ * number, so register N sits at byte offset N * 2.  A few of them have a
+ * meaningful upper byte that the vendor reaches with "N * 2 - 1"; those
+ * accesses are written out in full rather than hidden in a helper.
+ *
+ * The sequence follows the vendor's Titania3_series_start_ehc(), limited
+ * to the branches that the vendor build enables.  Silicon erratum
+ * workarounds are tagged ECO.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+
+/* UTMI analog registers */
+#define UTMI_MISC		0x00	/* termination and pull-down overrides */
+#define UTMI_HS_RX		0x03	/* disconnect window, fl_sel_override */
+#define UTMI_ECO		0x04	/* cross point and reset gating */
+#define UTMI_TX			0x06	/* TX current */
+#define UTMI_CDR		0x07
+#define UTMI_CLK		0x08	/* 240-as-120 phase, ECO bits */
+#define UTMI_RX_ISI		0x09
+#define UTMI_TX_TIMING		0x0b
+#define UTMI_CHIRP		0x15
+#define UTMI_PLL		0x22	/* UPLL enable */
+#define UTMI_DISCON		0x2a	/* disconnect + squelch level */
+#define UTMI_EYE0		0x2c
+#define UTMI_EYE1		0x2d
+#define UTMI_EYE2		0x2e
+#define UTMI_EYE3		0x2f
+#define UTMI_CA			0x3c	/* calibration start / done */
+#define UTMI_CA_OVERRIDE	0x3f
+#define UTMI_LEVEL_CTRL		0x40	/* chirp/disconnect level source */
+#define UTMI_CHIRP_LEVEL	0x42
+#define UTMI_TERM		0x52	/* termination overwrite */
+
+/* USBC MAC control registers */
+#define USBC_CTRL0		0x00	/* reset and XIU enable */
+#define USBC_CTRL2		0x02	/* UHC select, ECO bits */
+#define USBC_CTRL3		0x03	/* disconnect detection window */
+#define USBC_CTRL10		0x0a
+#define USBC_CTRL11		0x0b
+#define USBC_CTRLF		0x0f	/* preamble, MIU lower bound */
+#define USBC_CTRL13		0x10
+#define USBC_CTRL14		0x11
+#define USBC_HS_ISO		0x13
+#define USBC_CTRL20		0x19
+#define USBC_CTRL21		0x20	/* ECO bit field */
+#define USBC_CTRL22		0x21	/* EOF1 window */
+#define USBC_CTRL23		0x22	/* speed type reset timing */
+
+/* UHC host glue registers */
+#define UHC_RUN			0x34
+#define UHC_VBUS		0x40
+#define UHC_MIU			0x81
+#define UHC_MIU_WR		0x83
+#define UHC_EXTRA_SOF		0x8c
+
+/* Defaults from the vendor build, used when the firmware ships no DT data */
+#define MSTAR_SQUELCH_DEFAULT	0x02
+#define MSTAR_DISCONNECT_DEFAULT 0x60
+#define MSTAR_CHIRP_DEFAULT	0x80
+
+struct mstar_usb_phy {
+	struct device *dev;
+	void __iomem *utmi;
+	void __iomem *usbc;
+	void __iomem *uhc;
+	bool otg;
+	u8 squelch;
+	u8 disconnect;
+	u8 chirp;
+	u8 eye[4];
+};
+
+/* Register N of a window lives at byte offset 2 * N. */
+static void __iomem *reg16(void __iomem *base, unsigned int reg)
+{
+	return base + reg * 2;
+}
+
+/* Upper byte of register N. */
+static void __iomem *reg16_hi(void __iomem *base, unsigned int reg)
+{
+	return base + reg * 2 - 1;
+}
+
+static void setb(void __iomem *reg, u8 bits)
+{
+	writeb(readb(reg) | bits, reg);
+}
+
+static void clrb(void __iomem *reg, u8 bits)
+{
+	writeb(readb(reg) & ~bits, reg);
+}
+
+static void updateb(void __iomem *reg, u8 clear, u8 set)
+{
+	writeb((readb(reg) & ~clear) | set, reg);
+}
+
+static int mstar_usb_phy_init(struct phy *phy)
+{
+	struct mstar_usb_phy *p = phy_get_drvdata(phy);
+	void __iomem *utmi = p->utmi;
+	void __iomem *usbc = p->usbc;
+	void __iomem *uhc = p->uhc;
+	unsigned int i;
+
+	/* Force DP/DM termination while the UHC is still in reset, otherwise
+	 * the lines float and the port sees a phantom connect. */
+	setb(reg16(utmi, UTMI_MISC), BIT(7) | BIT(6) | BIT(1));
+	setb(reg16(utmi, UTMI_TERM), GENMASK(5, 0));
+
+	/* UPLL: this SoC only needs the enable bit; the m7322 divider
+	 * programming is gone. */
+	setb(reg16(utmi, UTMI_PLL), BIT(0));
+
+	/* Leave MAC suspend, then release UHC reset and switch on XIU. */
+	setb(reg16(usbc, USBC_CTRL0), BIT(1) | BIT(3));
+	updateb(reg16(usbc, USBC_CTRL0), BIT(1), BIT(5));
+
+	/* Squelch threshold has to be in place before calibration. */
+	writeb(p->squelch, reg16(utmi, UTMI_DISCON));
+
+	setb(reg16(utmi, UTMI_CA), BIT(0));
+	mdelay(1);
+	clrb(reg16(utmi, UTMI_CA), BIT(0));
+
+	for (i = 0; i < 100; i++) {
+		if (readb(reg16(utmi, UTMI_CA)) & BIT(1))
+			break;
+		udelay(10);
+	}
+	if (i == 100)
+		dev_warn(p->dev, "calibration did not finish\n");
+
+	/* Leaving the OTG port to the UDC driver, this SoC only has one. */
+	if (!p->otg)
+		updateb(reg16(usbc, USBC_CTRL2), BIT(1), BIT(0));
+
+	/* Drive VBUS, active high. */
+	clrb(reg16(uhc, UHC_VBUS), BIT(4));
+	udelay(1);
+	setb(reg16(uhc, UHC_VBUS), BIT(3));
+
+	/* The reset is over, stop overriding the line state. */
+	clrb(reg16(utmi, UTMI_MISC), BIT(7) | BIT(6) | BIT(1));
+	clrb(reg16(utmi, UTMI_TERM), GENMASK(5, 0));
+
+	/* Widen the PVCI write window so MIU traffic does not starve USB. */
+	setb(reg16_hi(uhc, UHC_MIU), BIT(0) | BIT(1) | BIT(2) | BIT(3) | BIT(7));
+
+	updateb(reg16(utmi, UTMI_TX), BIT(5), BIT(6));
+	updateb(reg16_hi(utmi, UTMI_HS_RX), BIT(4), BIT(3) | BIT(5));
+	clrb(reg16_hi(utmi, UTMI_CDR), BIT(1));		/* no improved CDR */
+	setb(reg16(utmi, UTMI_CLK), BIT(3));		/* 240 MHz as 120 MHz */
+	setb(reg16_hi(utmi, UTMI_RX_ISI), BIT(0) | BIT(7));
+	setb(reg16_hi(utmi, UTMI_TX_TIMING), BIT(7));	/* latch path */
+	setb(reg16_hi(utmi, UTMI_CHIRP), BIT(5));		/* chirp source */
+	setb(reg16_hi(utmi, UTMI_CHIRP), BIT(6));		/* 55 nm interface */
+
+	/* Hardware owned chirp and disconnect levels. */
+	clrb(reg16(utmi, UTMI_LEVEL_CTRL), BIT(4));
+	writeb(p->disconnect | p->squelch, reg16(utmi, UTMI_DISCON));
+	writeb(p->chirp, reg16(utmi, UTMI_CHIRP_LEVEL));
+	clrb(reg16(utmi, UTMI_LEVEL_CTRL), BIT(3));
+
+	setb(reg16(utmi, UTMI_EYE0), p->eye[0]);
+	setb(reg16_hi(utmi, UTMI_EYE1), p->eye[1]);
+	setb(reg16(utmi, UTMI_EYE2), p->eye[2]);
+	setb(reg16_hi(utmi, UTMI_EYE3), p->eye[3]);
+
+	/* ECO: low speed cross point deglitch. */
+	setb(reg16(utmi, UTMI_ECO), BIT(6));
+	/* ECO: reset TX/RX state machine on clock gating. */
+	setb(reg16(utmi, UTMI_ECO), BIT(5));
+	/* ECO: use EOF2 to reset the state machine. */
+	setb(reg16(usbc, USBC_CTRL2), BIT(6));
+	/* ECO: subtract the MIU lower bound. */
+	setb(reg16_hi(usbc, USBC_CTRLF), BIT(0));
+	/* ECO: PV2MI bridge. */
+	setb(reg16(usbc, USBC_CTRL10), BIT(6));
+	/* ECO: smallest PV2MI read/write burst. */
+	clrb(reg16_hi(usbc, USBC_CTRL11), BIT(1) | BIT(2) | BIT(3) | BIT(4));
+
+	/* ECO: preamble support. */
+	setb(reg16_hi(utmi, UTMI_CA_OVERRIDE), BIT(7));
+	setb(reg16_hi(usbc, USBC_CTRLF), BIT(3));
+	setb(reg16(usbc, USBC_CTRL13), BIT(0) | BIT(1));
+	setb(reg16_hi(utmi, UTMI_HS_RX), BIT(2));
+
+	/* ECO: never drop RUN on disconnect. */
+	setb(reg16(uhc, UHC_RUN), BIT(7));
+	/* ECO: wait for the last write to land before completing. */
+	setb(reg16_hi(uhc, UHC_MIU_WR), BIT(4));
+	/* ECO: extra high speed SOF after bus reset. */
+	setb(reg16(uhc, UHC_EXTRA_SOF), BIT(0));
+	/* ECO: high speed ISO IN corner case. */
+	setb(reg16_hi(usbc, USBC_HS_ISO), BIT(0));
+
+	/* ECO: speed type and port change handling. */
+	setb(reg16(usbc, USBC_CTRL21), BIT(0) | BIT(1) | BIT(2));
+	/* ECO: keep the controller running while disconnected. */
+	setb(reg16_hi(usbc, USBC_CTRL20), BIT(3));
+	/* ECO: interrupt when a split transaction clears ACT. */
+	setb(reg16_hi(usbc, USBC_CTRL14), BIT(7));
+	/* ECO: gate SRAM clocks automatically. */
+	clrb(reg16(usbc, USBC_CTRL21), BIT(4));
+	/* ECO: reset the speed type on connect or bus reset. */
+	setb(reg16(usbc, USBC_CTRL23), BIT(0));
+	setb(reg16(usbc, USBC_CTRL21), BIT(0));
+	/* ECO: gate a failed high speed connection into VFALL. */
+	setb(reg16_hi(usbc, USBC_CTRL14), BIT(1));
+	/* ECO: 16 us EOF1 window. */
+	updateb(reg16_hi(usbc, USBC_CTRL22), BIT(2) | BIT(3), 0);
+	setb(reg16_hi(usbc, USBC_CTRL22), BIT(4) | BIT(5));
+
+	/* Use two SOFs to detect a disconnect. */
+	writeb(0x05, reg16_hi(usbc, USBC_CTRL3));
+
+	return 0;
+}
+
+static const struct phy_ops mstar_usb_phy_ops = {
+	.init		= mstar_usb_phy_init,
+	.owner		= THIS_MODULE,
+};
+
+static int mstar_usb_phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mstar_usb_phy *p;
+	struct phy_provider *provider;
+	struct phy *phy;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = dev;
+
+	p->utmi = devm_platform_ioremap_resource_byname(pdev, "utmi");
+	if (IS_ERR(p->utmi))
+		return PTR_ERR(p->utmi);
+
+	p->usbc = devm_platform_ioremap_resource_byname(pdev, "usbc");
+	if (IS_ERR(p->usbc))
+		return PTR_ERR(p->usbc);
+
+	p->uhc = devm_platform_ioremap_resource_byname(pdev, "uhc");
+	if (IS_ERR(p->uhc))
+		return PTR_ERR(p->uhc);
+
+	p->otg = device_property_read_bool(dev, "mstar,otg-port");
+
+	if (device_property_read_u8(dev, "mstar,squelch", &p->squelch))
+		p->squelch = MSTAR_SQUELCH_DEFAULT;
+	if (device_property_read_u8(dev, "mstar,disconnect", &p->disconnect))
+		p->disconnect = MSTAR_DISCONNECT_DEFAULT;
+	if (device_property_read_u8(dev, "mstar,chirp", &p->chirp))
+		p->chirp = MSTAR_CHIRP_DEFAULT;
+	if (device_property_read_u8_array(dev, "mstar,eye-param", p->eye, 4)) {
+		p->eye[0] = 0x10;
+		p->eye[1] = 0x02;
+		p->eye[2] = 0x00;
+		p->eye[3] = 0x81;
+	}
+
+	phy = devm_phy_create(dev, NULL, &mstar_usb_phy_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+
+	phy_set_drvdata(phy, p);
+	platform_set_drvdata(pdev, p);
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id mstar_usb_phy_of_match[] = {
+	{ .compatible = "mstar,m7642-usb2-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mstar_usb_phy_of_match);
+
+static struct platform_driver mstar_usb_phy_driver = {
+	.probe	= mstar_usb_phy_probe,
+	.driver = {
+		.name		= "mstar-usb2-phy",
+		.of_match_table	= mstar_usb_phy_of_match,
+	},
+};
+module_platform_driver(mstar_usb_phy_driver);
+
+MODULE_DESCRIPTION("MStar m7642 USB2 UTMI PHY");
+MODULE_LICENSE("GPL");
