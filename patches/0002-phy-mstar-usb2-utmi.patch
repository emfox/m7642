From 076d4bedcadcec9c453987b0bb0b8ce208ad64d5 Mon Sep 17 00:00:00 2001
From: emfox <emfox@debian.org>
Date: Tue, 17 Nov 2026 16:55:20 +0800
Subject: [PATCH] phy: mstar: add USB2 UTMI PHY driver for m7642

MediaTek MT9652 (MStar m7642) has four EHCI ports, each with its own UTMI
analog block.  The registers in that block are 16 bits wide and addressed
at twice their register number, so a driver has to touch them a halfword
at a time.

Add a generic PHY driver running the vendor's bring-up sequence: hold the
line termination while the host controller is in reset, release the reset,
calibrate, drive VBUS, then apply the analog trims.  The sequence is a
transcription of the vendor's Titania3_series_start_ehc(), limited to the
branches the vendor build actually enables, erratum workarounds included.

The trim values come from the vendor defaults and can be overridden per
port from the device tree.

Signed-off-by: emfox <emfox@debian.org>
---
 .../bindings/phy/mstar,usb2-phy.yaml          |  75 +++++
 drivers/phy/Kconfig                           |   1 +
 drivers/phy/Makefile                          |   1 +
 drivers/phy/mstar/Kconfig                     |   6 +
 drivers/phy/mstar/Makefile                    |   2 +
 drivers/phy/mstar/phy-mstar-usb.c             | 310 ++++++++++++++++++
 6 files changed, 395 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/mstar,usb2-phy.yaml
 create mode 100644 drivers/phy/mstar/Kconfig
 create mode 100644 drivers/phy/mstar/Makefile
 create mode 100644 drivers/phy/mstar/phy-mstar-usb.c

diff --git a/Documentation/devicetree/bindings/phy/mstar,usb2-phy.yaml b/Documentation/devicetree/bindings/phy/mstar,usb2-phy.yaml
new file mode 100644
index 0000000..013c52e
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/mstar,usb2-phy.yaml
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/mstar,usb2-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MStar m7642 USB2 UTMI PHY
+
+description:
+  One instance per EHCI port.  A port owns three register windows inside the
+  SoC's USB block: the UTMI analog registers, the USBC MAC control registers
+  and the UHC host glue registers.  Registers in all three windows are 16 bits
+  wide and addressed at twice their register number.
+
+maintainers:
+  - Emfox Zhou <emfox@debian.org>
+
+properties:
+  compatible:
+    const: mstar,m7642-usb2-phy
+
+  reg:
+    items:
+      - description: UTMI analog registers
+      - description: USBC MAC control registers
+      - description: UHC host glue registers
+
+  reg-names:
+    items:
+      - const: utmi
+      - const: usbc
+      - const: uhc
+
+  "#phy-cells":
+    const: 0
+
+  mstar,otg-port:
+    $ref: /schemas/types.yaml#/definitions/flag
+    description:
+      This port belongs to the USB device controller, so the PHY leaves the
+      UHC select bit alone and lets the UDC driver drive it.
+
+  mstar,squelch:
+    $ref: /schemas/types.yaml#/definitions/uint8
+    description: Squelch level, written as the low nibble of the disconnect register.
+
+  mstar,disconnect:
+    $ref: /schemas/types.yaml#/definitions/uint8
+    description: Disconnect threshold, written as the high nibble of the disconnect register.
+
+  mstar,chirp:
+    $ref: /schemas/types.yaml#/definitions/uint8
+    description: Chirp detect level.
+
+  mstar,eye-param:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    description: Four eye diagram trim values, in register order.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    phy@1f202900 {
+        compatible = "mstar,m7642-usb2-phy";
+        reg = <0x1f202900 0x100>, <0x1f202400 0x100>, <0x1f202600 0x100>;
+        reg-names = "utmi", "usbc", "uhc";
+        #phy-cells = <0>;
+    };
+...
