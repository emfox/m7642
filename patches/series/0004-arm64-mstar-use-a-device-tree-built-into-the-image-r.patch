diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 715e971eb..940b058a8 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -196,6 +196,32 @@ config ARCH_MSTAR
 	  This enables support for MStar TV SoCs, now part of MediaTek.
 	  Currently covers the m7642, marketed as the MT9652.
 
+config MSTAR_M7642_BUILTIN_DTB
+	bool "Use the built-in device tree on m7642"
+	depends on ARCH_MSTAR
+	help
+	  Bring-up aid.  Ignore the device tree passed by the bootloader and
+	  use the board DTB compiled into the image instead.
+
+	  This bootloader reads its DTB from a dedicated raw partition that
+	  the stock kernel depends on as well, so replacing it there is a
+	  one-way door.  Carrying our own copy keeps that partition intact.
+
+	  Say N for a kernel that should honour the firmware's device tree.
+
+config MSTAR_M7642_BEACON
+	bool "Paint the framebuffer from primary_entry (bring-up aid)"
+	depends on ARCH_MSTAR
+	help
+	  Writes a solid colour into the scanout buffer as the very first
+	  instructions of primary_entry, before the MMU or a stack exist.
+
+	  Turn this on only when there is no serial console: it is the sole
+	  way to tell whether the bootloader jumped to the kernel at all.  It
+	  must stay off for any kernel that is expected to run normally, and
+	  for anything tested under QEMU, where the framebuffer address is not
+	  mapped.
+
 
 config ARCH_MESON
 	bool "Amlogic Platforms"
