@@ -59,6 +59,10 @@ static int num_standard_resources;
 static struct resource *standard_resources;
 
 phys_addr_t __fdt_pointer __initdata;
+
+#ifdef CONFIG_MSTAR_M7642_BUILTIN_DTB
