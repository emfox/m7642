 u64 mmu_enabled_at_boot __initdata;
 
 /*
@@ -289,6 +293,14 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_fixmap_init();
 	early_ioremap_init();
 
+#ifdef CONFIG_MSTAR_M7642_BUILTIN_DTB
+	/*
+	 * Bring-up aid: ignore the firmware's device tree and use the board
+	 * DTB carried in the image.  The vendor tree lives in a raw partition
+	 * the stock kernel also uses, so it must not be replaced from Linux.
+	 */
+	__fdt_pointer = __pa_symbol(__m7642_dtb);
+#endif
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
@@ -373,6 +385,13 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 			"This indicates a broken bootloader or old kernel\n",
 			boot_args[1], boot_args[2], boot_args[3]);
 	}
+
+	/*
+	 * Synchronous abort on this TV's panel is already ruled out as a usable
+	 * signal, and writing the framebuffer here would be the only memory write
+	 * in setup_arch() that can fault if the MMU happens to be on with that
+	 * page unmapped, so no beacon is painted.
+	 */
 }
 
