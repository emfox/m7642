From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m7642 <m7642@local>
Date: Mon, 23 Nov 2026 00:25:05 +0800
Subject: [PATCH 8/9] arm64: pi/map_range: bring-up comment about the earlier
 colour checkpoints

---
 arch/arm64/kernel/pi/map_range.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/kernel/pi/map_range.c b/arch/arm64/kernel/pi/map_range.c
index 761b14893..1912cfb46 100644
--- a/arch/arm64/kernel/pi/map_range.c
+++ b/arch/arm64/kernel/pi/map_range.c
@@ -11,6 +11,26 @@
 
 #include "pi.h"
 
+/*
+ * LOCAL BRING-UP AIDS -- not intended for upstream.
+ *
+ * Checkpoints inside create_init_idmap() rather than at its call site, because
+ * the kernel stops somewhere in here: green is the last colour that survives
+ * on the panel, and green is painted immediately before this function is
+ * called.  Nothing in this function writes the scanout buffer, so unlike a
+ * checkpoint placed between two functions, these greys cannot be repainted by
+ * whatever runs next -- seeing one is a definite reading.
+ *
+ *	0x4210	entered the body: prologue, stack and argument setup are fine
+ *	0x8410	the _stext..__initdata_begin range is mapped
+ */
+#if defined(CONFIG_MSTAR_M7642_BEACON) && defined(CONFIG_MSTAR_M7642_BUILTIN_DTB)
+extern void m7642_mark(u32 colour);
+#define M7642_MARK(c)		m7642_mark(c)
+#else
+#define M7642_MARK(c)		do { } while (0)
+#endif
+
 /**
  * map_range - Map a contiguous range of physical pages into virtual memory
  *
@@ -97,10 +117,15 @@ asmlinkage phys_addr_t __init create_init_idmap(pgd_t *pg_dir, ptval_t clrmask)
 	pgprot_val(text_prot) &= ~clrmask;
 	pgprot_val(data_prot) &= ~clrmask;
 
+	M7642_MARK(0x4210);
+
 	/* MMU is off; pointer casts to phys_addr_t are safe */
 	map_range(&ptep, (u64)_stext, (u64)__initdata_begin,
 		  (phys_addr_t)_stext, text_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
+
+	M7642_MARK(0x8410);
+
 	map_range(&ptep, (u64)__initdata_begin, (u64)_end,
 		  (phys_addr_t)__initdata_begin, data_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
