+U32 eMMC_CheckIfReady(void)
+{
+	if(eMMC_NOT_READY_MARK != sgu32_IfReadyGuard)
+		return eMMC_ST_SUCCESS;
+	else
+		return eMMC_Init_Ex();
+}
