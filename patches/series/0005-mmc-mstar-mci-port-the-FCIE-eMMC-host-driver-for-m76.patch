diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index 4f060d3e5..e6d7b24b8 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -1156,3 +1156,33 @@ config MMC_LITEX
 	  module will be called litex_mmc.
 
 	  If unsure, say N.
+
+config MMC_MSTAR_MCI
+	tristate "MStar/MTK m7642 FCIE (eMMC) support"
+	depends on ARCH_MSTAR || COMPILE_TEST
+	depends on MMC
+	help
+	  This selects the MStar/MTK FCIE eMMC host controller found on the
+	  m7642 (MT9652) and related TV SoCs.
+
+	  The controller has 16-bit registers on a 4-byte stride inside the
+	  RIU window at 0x1f000000, and its own DMA engine.  It is not
+	  SDHCI and not dw_mmc.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mstar-mci.
+
+config MMC_MSTAR_MCI_STRICT_VERSION
+	bool "Hang when MBoot and kernel eMMC driver versions disagree"
+	depends on MMC_MSTAR_MCI
+	help
+	  The vendor driver refuses to run when the value MBoot left in
+	  FCIE_RESERVED_FOR_SW does not match eMMC_DRIVER_VERSION, and spins
+	  forever if it does not.
+
+	  For bring-up that is unhelpful: the box stops with two lines on the
+	  console and nothing to inspect.  Default is to warn and keep going,
+	  so the rest of the init sequence can report where it fails.
+
+	  Say Y only for a production build where a silent storage stack would
+	  be worse than a hang.
