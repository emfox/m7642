+# SPDX-License-Identifier: GPL-2.0-only
+#
+# MStar/MTK m7642 FCIE eMMC controller.
+#
+# The sources are a flat copy of kernel_mstar-main 4.9.118
+# drivers/mstar2/{drv,hal}/.../mmc so that a diff against the vendor tree stays
+# a plain file-to-file comparison.  Do not reorganise them.
+
+obj-$(CONFIG_MMC_MSTAR_MCI)	+= mstar-mci.o
+
+mstar-mci-y := mstar_mci_v5.o eMMC_hal_v5.o eMMC_hal_speed.o eMMC_utl.o eMMC_prg.o eMMC_platform.o
+
+ccflags-y += -I$(src)
