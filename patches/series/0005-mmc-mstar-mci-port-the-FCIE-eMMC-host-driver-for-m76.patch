+
+    u16Tmp = REG_FCIE(FCIE_CIFD_ADDR(u8addr>>1));
+
+    if(u8addr&0x1)
+        return ((u16Tmp>>8)&0xFF);
+    else
+        return (u16Tmp&0xFF);
+}
