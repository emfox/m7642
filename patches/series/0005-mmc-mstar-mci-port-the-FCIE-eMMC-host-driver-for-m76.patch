+#define FICE_BYTE_MODE_ENABLE           1 // always 1
+/*
+ * Porting note (7.3): the three switches below are turned off on purpose.
+ *
+ *  - INTERRUPT_MODE=0 makes eMMC_FCIE_Init() install eMMC_FCIE_PollingEvents
+ *    as the wait function.  That removes the dependency on the vendor legacy
+ *    interrupt layer (E_IRQ_NFIE / spi_to_ppi[]) entirely, which has no
+ *    equivalent in a mainline tree.
+ *  - ASYNC_IO=0 drops the extra kthread and the queue_work() indirection, so
+ *    the data phase runs synchronously inside ->request.
+ *  - POWER_SAVING_MODE=0 skips the SAR5 / PWR_SAVE_CTL dance, which needs a
+ *    board GPIO table we do not have.
+ */
+#define ENABLE_eMMC_INTERRUPT_MODE      0
+#define ENABLE_eMMC_RIU_MODE            0 // for debug cache issue
