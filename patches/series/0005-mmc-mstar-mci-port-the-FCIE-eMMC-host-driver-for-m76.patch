+		{
+			eMMC_debug(eMMC_DEBUG_LEVEL_ERROR, 1,
+				"eMMC WARN: CMD%u SD_STS: %04Xh \n", u8_CmdIdx, u16_reg);
+			return eMMC_ST_ERR_CMD3536_ERR;
