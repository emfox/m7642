+U32 eMMC_hw_timer_delay(U32 u32us)
+{
+    #if 0 // udelay not work
+    volatile u32 i = 0;
+
+    for (i = 0; i < (u32us>>0); i++)
+    {
+        #if 1
+        volatile int j = 0, tmp;
+        for (j = 0; j < 0x38; j++)
+        {
+            tmp = j;
+        }
+        #endif
+    }
+    #else
+    U32 u32_i = u32us;
+
+    while(u32_i > 1000)
+    {
+        mdelay(1);
+        u32_i -= 1000;
+    }
+
+    udelay(u32_i);
+    #endif
+
+    return u32us;
+}
+
+U32 eMMC_hw_timer_sleep(U32 u32ms)
+{
+    U32 u32_i = u32ms;
+
+    while(u32_i > 1000)
+    {
+        if(sleep_or_delay!=NULL)
+        {
+                sleep_or_delay(1000);
+        }
+
+        u32_i -= 1000;
+    }
+
+    if(sleep_or_delay!=NULL)
+    {
+         sleep_or_delay(u32_i);
+    }
+
+    return u32ms;
+}
