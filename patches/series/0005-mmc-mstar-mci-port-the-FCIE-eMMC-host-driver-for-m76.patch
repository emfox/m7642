+		g_eMMCDrv.BurstWriteLen_t.u16_BestMBPerSec, g_eMMCDrv.BurstWriteLen_t.u16_BestMBPerSecPoint);
+	eMMC_debug(eMMC_DEBUG_LEVEL,0,"    worst: %4u blks, %4u.%u MB/s \n",
