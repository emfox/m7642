diff --git a/drivers/mmc/host/mstar-mci/mstar_mci_shim.h b/drivers/mmc/host/mstar-mci/mstar_mci_shim.h
new file mode 100644
index 000000000..7990e393e
--- /dev/null
+++ b/drivers/mmc/host/mstar-mci/mstar_mci_shim.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Vendor glue for the MStar/MTK m7642 FCIE eMMC controller.
+ *
+ * The vendor code under this directory is a drop from
+ * kernel_mstar-main 4.9.118, drivers/mstar2/{drv,hal}/.../mmc.  It talks to
+ * the controller through five headers that only exist in that tree.  This
+ * file replaces those five with the minimum they actually provided.
+ *
+ * Everything here is deliberately dumb: no abstractions that the vendor code
+ * did not already assume, so that a diff against the vendor sources stays
+ * readable.
+ */
+
+#ifndef __MSTAR_MCI_SHIM_H
+#define __MSTAR_MCI_SHIM_H
+
+#include <linux/types.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+
+/*
+ * Types: not here.  eMMC_config.h already defines U8/U16/U32/S32/S64 as macros
+ * and it is included first through eMMC.h, so a typedef here would expand into
+ * "typedef u32 unsigned int" and fail.
+ */
+
+/* ---- BIT0..BIT15, supplied by the vendor's chip_setup.h ---------------- */
+#define BIT0	(1U << 0)
+#define BIT1	(1U << 1)
+#define BIT2	(1U << 2)
+#define BIT3	(1U << 3)
+#define BIT4	(1U << 4)
+#define BIT5	(1U << 5)
+#define BIT6	(1U << 6)
+#define BIT7	(1U << 7)
+#define BIT8	(1U << 8)
+#define BIT9	(1U << 9)
+#define BIT10	(1U << 10)
+#define BIT11	(1U << 11)
+#define BIT12	(1U << 12)
+#define BIT13	(1U << 13)
+#define BIT14	(1U << 14)
+#define BIT15	(1U << 15)
+
+/*
+ * RIU window.  The vendor set mstar_pm_base from init/main.c as
+ * ioremap(IO_PHYS = 0x1f000000, 0xa00000), and every FCIE / CLKGEN / PAD /
+ * EMMC_PLL register is an offset into that window.  We map the same window
+ * so that all the address arithmetic in eMMC_linux.h keeps working unchanged.
+ *
+ * 0xa00000 covers up to 0x1f9fffff; the highest register we touch is
+ * EMMC_PLL + 0x45 << 2 = 0x1f247f14.
+ */
+#define MSTAR_PM_PHYS		0x1f000000UL
+#define MSTAR_PM_SIZE		0x00a00000UL
+
+/*
+ * MIU bus windows.  They were in arch/arm64/include/mstar/mstar_chip.h.
+ *
+ * The driver turns a DMA address into the value it programs into
+ * FCIE_MIU_DMA_ADDR_* by subtracting the MIU window the buffer lives in.
+ * With ENABLE_UMA=1 and neither M7821 nor MSTAR_MIU1_BUS_BASE_H defined, the
+ * code collapses to "dmaaddr -= MSTAR_MIU0_BUS_BASE", i.e. it expects
+ * ->dma_addr to be the MIU0 window at 0x2000_0000 and above.  That is what
+ * dma-direct hands out here, so the arithmetic works out; see emmc.md for the
+ * dma-ranges question that still has to be answered on the DT side.
+ */
+#define MSTAR_MIU0_BUS_BASE	0x20000000UL
+#define MSTAR_MIU1_BUS_BASE	0xA0000000UL
+
+/*
+ * mstar_pm_base itself is declared in eMMC_linux.h as uintptr_t, because every
+ * register in this driver is computed from it as an integer.  It is defined in
+ * mstar_mci_v5.c as the ioremap() of MSTAR_PM_PHYS.
+ */
+
+/* ---- what <mstar/mstar_chip.h> was used for: chip revision ------------- */
+#define MSTAR_CHIP_M7642	1
+#define CONFIG_MSTAR_M7642	1
+
+#endif /* __MSTAR_MCI_SHIM_H */
