+			if(eMMC_ST_SUCCESS != u32_err)
+			{
+				eMMC_debug(eMMC_DEBUG_LEVEL_ERROR, 1,
+				    "eMMC Err: CMD%u check R1 error: %Xh\n", u8_CmdIdx, u32_err);
+				return u32_err;
+			}
