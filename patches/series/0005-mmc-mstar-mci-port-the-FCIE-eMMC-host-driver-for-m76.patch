+U32 eMMC_Sanitize(U8 u8_ECSD165)
+{
+	U32 u32_err;
+
+	u32_err = eMMC_ModifyExtCSD(eMMC_ExtCSD_WByte, 165, u8_ECSD165);
+	if(eMMC_ST_SUCCESS != u32_err)
+		return u32_err;
+
+	u32_err = eMMC_FCIE_WaitD0High(TIME_WAIT_DAT0_HIGH<<2);
+	if(eMMC_ST_SUCCESS != u32_err)
+		return u32_err;
+
+	return eMMC_ST_SUCCESS;
+}
