+		REG_FCIE_R(FCIE_MIE_EVENT, u16_reg);
+		if(0==(u16_reg&BIT_ALL_CARD_INT_EVENTS))
+			break;
+		REG_FCIE_W(FCIE_MIE_EVENT, 0);
+		REG_FCIE_W(FCIE_MIE_EVENT, 0);
+	}
+}
