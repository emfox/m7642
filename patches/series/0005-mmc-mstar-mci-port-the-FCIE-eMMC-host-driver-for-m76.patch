+static int mstar_mci_get_dma_dir(struct mmc_data *data)
+{
+    #if defined(CONFIG_ENABLE_EMMC_ACP) && CONFIG_ENABLE_EMMC_ACP
+
+    return DMA_ACP;
+
+    #else
+
+    if (data->flags & MMC_DATA_WRITE)
+        return DMA_TO_DEVICE;
+    else
+        return DMA_FROM_DEVICE;
+
+    #endif
